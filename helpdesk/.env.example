# Helpdesk example — environment variables
# Copy to .env and fill in your values.

# LLM provider (Gemini required — used for LLM + embeddings in orchid.yml)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override Qdrant URL (default: http://qdrant:6333)
# QDRANT_URL=http://localhost:6333

# MCP gateway token (any value — dev_bypass=true ignores it)
MCP_TOKEN=demo-token
