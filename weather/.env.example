# Weather example — environment variables
# Copy to .env and fill in your values.

# LLM provider
GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# PostgreSQL password (default: orchid)
POSTGRES_PASSWORD=orchid

# MCP gateway token (any value — dev_bypass=true ignores it)
MCP_TOKEN=demo-token
