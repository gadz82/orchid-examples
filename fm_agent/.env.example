# FM Agent — environment variables
# Copy to .env and fill in your values.

# LLM provider (required)
GEMINI_API_KEY=

# PostgreSQL password (default: orchid)
POSTGRES_PASSWORD=orchid

# Neo4j credentials (Phase 4, profile "graph")
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=Password123

# MCP gateway token
MCP_TOKEN=demo-token

# MCP server credentials (Phase 5)
# Atlassian OAuth (for atlassian-rovo MCP server)
# Register your app at https://developer.atlassian.com/console/myapps/
# Add the callback URL: http://localhost:8080/mcp/auth/callback (or your API_BASE_URL)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# ATLASSIAN_OAUTH_CLIENT_ID=
# ATLASSIAN_OAUTH_CLIENT_SECRET=
# ATLASSIAN_MCP_TOKEN=
# ATLASSIAN_DOMAIN=
# ATLASSIAN_EMAIL=
# ATLASSIAN_API_TOKEN=
# GITLAB_TOKEN=
DD_API_KEY=
DD_APP_KEY=
DD_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Qdrant URL (overrides orchid.yml if set)
# QDRANT_URL=http://qdrant:6333
