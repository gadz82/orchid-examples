# Event-driven data pipeline example — local Ollama profile.
#
# The decision model is the deterministic stub, so no decision-provider key is
# required. The LLM and agent jobs use Ollama on the host.
OLLAMA_API_BASE=http://host.docker.internal:11434
LLM_MODEL=ollama/llama3.2
LITELLM_MODEL=ollama/llama3.2
# Bearer token for the customer-health webhook source.
PIPELINE_INGEST_TOKEN=dev-ingest-token
