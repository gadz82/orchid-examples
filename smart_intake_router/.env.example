# Chat model used for synthesis. The routing/skill/tool decisions use the
# deterministic stub in config/agents.yaml and need no key.
# Docker reaches the host Ollama at host.docker.internal:11434.
LLM_MODEL=ollama/gemma4:26b

# Optional: route with TypeSafe/Jev instead of the stub.
# Set DECISION_ROUTING_MODEL=jev and provide the key. TYPESAFE_BASE_URL
# defaults to https://api.typesafe.ai; if you override it for a gateway,
# add the new host to allowed_decision_hosts in config/agents.yaml.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# DECISION_ROUTING_MODEL=jev
